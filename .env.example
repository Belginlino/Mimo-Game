# ==============================================================================
# Mimo — Your AI Playmate Environment Configuration
# ==============================================================================

# Project Name & Public Metadata
PROJECT_NAME="Mimo — Your AI Playmate"
VERSION="1.0.0"

# Database Configuration (Defaults to SQLite for instant local setup)
# For production PostgreSQL: postgresql://user:password@localhost:5432/mimo
DATABASE_URL="sqlite:///./mimo.db"

# Allowed CORS Origins (JSON array of strings)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# ------------------------------------------------------------------------------
# AI Chat Provider Configuration
# Options:
#   - "demo": High-quality offline local conversational playmate (No API key needed!)
#   - "gemini": Google Gemini API (Requires GEMINI_API_KEY)
#   - "openai": OpenAI ChatGPT API (Requires OPENAI_API_KEY)
# ------------------------------------------------------------------------------
AI_CHAT_PROVIDER="demo"
ENABLE_DEMO_FALLBACK="True"

# Optional: Google Gemini API Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optional: OpenAI API Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 3D Avatar Generation Provider Configuration
# Options:
#   - "mock": Local mock provider for instant testing and CI (No API key needed)
#   - "meshy": Official Meshy Image-to-3D REST API (Requires MESHY_API_KEY)
# ------------------------------------------------------------------------------
IMAGE3D_PROVIDER="mock"

# Optional: Meshy API Key (from https://meshy.ai)
MESHY_API_KEY=""
MESHY_API_BASE_URL="https://api.meshy.ai/openapi/v1"

# Safety Limits
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB
RATE_LIMIT_CHAT_PER_MINUTE=30
